# =====================================================================
# ToddlerTime - environment variables
# Salin ke .env.local untuk pengembangan, dan isi juga di Vercel
# (Project Settings > Environment Variables) untuk deploy.
# =====================================================================

# --- Supabase (wajib) -------------------------------------------------
# Supabase Dashboard > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key: SERVER-ONLY & RAHASIA. Jangan diberi prefix NEXT_PUBLIC_.
# Dipakai untuk PIN dan kelonggaran waktu kontrol orang tua.
SUPABASE_SERVICE_ROLE_KEY=

# Opsional: kunci tanda tangan cookie "sesi orang tua".
# Kosongkan untuk memakai SUPABASE_SERVICE_ROLE_KEY.
PARENTAL_SESSION_SECRET=

# --- Akun demo (opsional) ---------------------------------------------
# Mengaktifkan tombol "Coba akun demo" di /login.
# Hanya dibaca di server (Server Action), tidak ikut ke bundle browser.
NEXT_PUBLIC_DEMO_EMAIL=
NEXT_PUBLIC_DEMO_PASSWORD=

# --- URL situs (opsional) ---------------------------------------------
# Untuk metadata Open Graph & sitemap. Di Vercel otomatis memakai domain
# produksi bila dikosongkan.
NEXT_PUBLIC_SITE_URL=

# --- Hanya untuk skrip seed (tidak perlu di Vercel) -------------------
# YouTube Data API v3, dipakai oleh `npm run seed`.
YOUTUBE_API_KEY=
